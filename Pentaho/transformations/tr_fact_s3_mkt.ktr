    <formula>
      <field_name>material_no</field_name>
      <formula_string>"P-"&amp;RIGHT([seller_sku];4)</formula_string>
      <value_type>String</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>line_gross</field_name>
      <formula_string>[qty]*[price]</formula_string>
      <value_type>Number</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>disc_pct</field_name>
      <formula_string>[voucher]*100/([qty]*[price])</formula_string>
      <value_type>Number</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>unit_price_ex_vat</field_name>
      <formula_string>[price]/1.11</formula_string>
      <value_type>Number</value_type>
      <value_length>-1</value_length>
      <value_precision>2</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>gross_sales</field_name>
      <formula_string>[qty]*[price]/1.11</formula_string>
      <value_type>Number</value_type>
      <value_length>-1</value_length>
      <value_precision>2</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>discount_amount</field_name>
