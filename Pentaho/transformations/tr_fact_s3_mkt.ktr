    <connection>nusantara_store_star_scheme</connection>
    <rowlimit>0</rowlimit>
    <sql>SELECT COALESCE(
  (SELECT campaign_key FROM dim_campaign
   WHERE campaign_code &lt;&gt; 'NO_PROMO'
     AND DATE(?) BETWEEN DATE(start_date) AND DATE(end_date)
     AND target_discount_pct = ?
     AND campaign_scope IN (?, 'Semua Kanal')
   ORDER BY (campaign_scope = 'Semua Kanal'), start_date DESC LIMIT 1),
  (SELECT campaign_key FROM dim_campaign WHERE campaign_code = 'NO_PROMO' LIMIT 1)
) AS campaign_key</sql>
    <outer_join>N</outer_join>
    <replace_vars>N</replace_vars>
    <parameter>
      <field>
        <name>paid_wib</name>
        <type>None</type>
      </field>
      <field>
        <name>disc_pct</name>
        <type>None</type>
      </field>
      <field>
        <name>scope_name</name>
        <type>None</type>
      </field>
    </parameter>
