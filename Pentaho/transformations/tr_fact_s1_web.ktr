      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Database join 2</name>
    <type>DBJoin</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>star_scheme_nusantara_db</connection>
    <rowlimit>0</rowlimit>
    <sql>SELECT base_price AS unit_cost FROM stg_product_cost
WHERE material_no = ? AND available_since &lt;= DATE(?)
ORDER BY available_since DESC LIMIT 1</sql>
    <outer_join>N</outer_join>
    <replace_vars>N</replace_vars>
    <parameter>
      <field>
        <name>material_no</name>
