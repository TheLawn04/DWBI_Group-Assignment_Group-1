  <step>
    <name>Formula</name>
    <type>Formula</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <formula>
      <field_name>material_no</field_name>
      <formula_string>IF(ISBLANK([map_material_no]);[sku];[map_material_no])</formula_string>
      <value_type>String</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>customer_key_str</field_name>
      <formula_string>"ECOM-"&amp;[customer_id]</formula_string>
      <value_type>String</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>timestamp_key</field_name>
      <formula_string>YEAR([order_ts])*10000+MONTH([order_ts])*100+DAY([order_ts])</formula_string>
      <value_type>Integer</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>unit_price_ex_vat</field_name>
      <formula_string>[unit_price]/1.11</formula_string>
      <value_type>Number</value_type>
      <value_length>-1</value_length>
      <value_precision>2</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>gross_sales</field_name>
      <formula_string>[qty]*[unit_price]/1.11</formula_string>
      <value_type>Number</value_type>
      <value_length>-1</value_length>
      <value_precision>2</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>discount_amount</field_name>
      <formula_string>[disc_amount]/1.11</formula_string>
      <value_type>Number</value_type>
      <value_length>-1</value_length>
      <value_precision>2</value_precision>
      <replace_field/>
    </formula>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
