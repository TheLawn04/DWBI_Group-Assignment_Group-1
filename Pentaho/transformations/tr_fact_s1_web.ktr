    <connection>star_scheme_nusantara_db</connection>
    <rowlimit>0</rowlimit>
    <sql>SELECT COALESCE(
    (SELECT campaign_key 
FROM dim_campaign 
WHERE voucher_id = ? 
AND voucher_id > 0 LIMIT 1),
    (SELECT campaign_key 
FROM dim_campaign 
WHERE campaign_code = 'NO_PROMO' 
LIMIT 1)
) AS campaign_key</sql>
    <outer_join>N</outer_join>
    <replace_vars>N</replace_vars>
    <parameter>
      <field>
        <name>voucher_id</name>
        <type>None</type>
      </field>
    </parameter>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
